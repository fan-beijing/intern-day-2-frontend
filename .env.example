# 前端 API 基地址：浏览器直接访问宿主机映射的后端端口
VITE_API_BASE_URL=http://localhost:8000

# ── 第三天：CopilotKit Runtime ──────────────────────────────
# 只影响 Vite 的代理目标和 Runtime 自身的配置，都不会打进浏览器产物。

# Vite 把 /api/copilotkit 代理到这里（容器内用服务名）
RUNTIME_URL=http://localhost:4000

# Runtime 转发到的 Python AG-UI 地址（容器内跨 Compose 项目，走宿主机）
BACKEND_AGENT_URL=http://host.docker.internal:8000/agent

# Runtime 的 CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 注册给前端的 Agent 标识，必须与后端 Agent 一致
AGENT_ID=xuelu-ledger-assistant
