# 前端 API 基地址：浏览器直接访问宿主机映射的后端端口
VITE_API_BASE_URL=http://localhost:8000

# ── 第三天：CopilotKit Runtime（浏览器不直接访问，由 Vite 同源代理）──────────
# 浏览器只请求 /api/copilotkit，Vite 把它转给 Runtime。
RUNTIME_URL=http://localhost:4000

# 与后端 Agent 标识保持一致（app/routers/agent.py 的 AGENT_NAME）
AGENT_ID=xuelu-ledger-assistant

# Runtime 转发到的 Python AG-UI 地址。
# 两个 Compose 项目互不相识，容器内默认经宿主机端口访问另一个项目的 8000。
BACKEND_AGENT_URL=http://host.docker.internal:8000/agent

# 允许跨域访问 Runtime 的页面来源
ALLOWED_ORIGINS=http://localhost:5173
